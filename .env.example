PORT=8787
DATA_DIR=./data
PHOTOS_DIR=./photos
# CORS_ORIGIN=https://vrc.mcwind.cloud
# Behind a reverse proxy (nginx/caddy): enable so Express trusts X-Forwarded-For.
# Also required for correct admin IP checks when the proxy is on a private IP.
TRUST_PROXY=1
NODE_ENV=production

# Admin password (recommended in production). Requires private-network IP + login.
# ADMIN_PASSWORD=change-me-to-a-long-random-string
# Dedicated secret for signing admin session cookies (32+ random bytes).
# ADMIN_JWT_SECRET=change-me-to-another-long-random-string
# ADMIN_SESSION_HOURS=24
# ADMIN_COOKIE_SECURE=1
